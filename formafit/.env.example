# FormaFit environment variables. Copy to .env.local and fill in values.
# Never commit real secrets.

# Supabase (Project settings → API). The publishable/anon key is safe for the browser;
# Row Level Security protects all private data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of the app, used in auth email redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Claude API (server-side only). AI features are disabled when unset.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=

# Open Food Facts product search and barcode lookup (public API, no key required).
OPENFOODFACTS_ENABLED=true
# Open Food Facts asks clients to identify themselves: "AppName/Version (contact)".
OPENFOODFACTS_USER_AGENT=

# Per-user AI rate limits (requests per hour).
AI_COACH_HOURLY_LIMIT=30
AI_GENERATION_HOURLY_LIMIT=10

# Push reminders (optional). Generate a key pair with: npx web-push generate-vapid-keys
# The public key is sent to browsers; the private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=
# Secret for the reminder job: GET/POST /api/cron/reminders with "Authorization: Bearer <CRON_SECRET>".
# At least 32 characters, e.g. from: openssl rand -hex 32
CRON_SECRET=

# Server-only and never exposed to the browser. Used by the reminder job (it reads due
# reminders for all users) and by integration/E2E test tooling.
SUPABASE_SERVICE_ROLE_KEY=
